# (Custom Search 모드) Programmable Search Engine + Custom Search JSON API
GOOGLE_CSE_API_KEY=your_custom_search_api_key
GOOGLE_CSE_ID=your_search_engine_id_cx

# PostgreSQL (대화 세션 저장)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot
