__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables (API 키, DB 접속 정보)
.env
.env_*

# 로컬 전용 보관함: 옛 평가 스크립트·결과물, 제출용 패키지, 압축본 등 (저장소에 올리지 않음)
_local_archive/

# RAG: 저작권 있는 원본 PDF, 책 전문이 담긴 DB, 압축본
rag/uploads/*.pdf
rag/uploads/last_indexed_info.json
*.db
*.zip

# RAG: 청크 본문(책 내용)이 들어 있는 평가 원본 (capture_ui_35.py / eval_*.py로 재생성)
rag/ui_run_35.json
rag/eval_metrics_35.json
rag/eval_refusal_35.json

# RAG: 청크 검색 결과를 덤프한 임시 파일 (책 본문 포함)
scratch_*.txt

# RAG: 인덱싱/질문 실행 로그 (질문·답변 원문 포함, rag/run_logger.py가 생성)
rag/logs/
